# Скопировать в .env (run.ps1 / run.sh делают это сами). .env в репозиторий не коммитить.
# Общий ключ команды для X-API-Key — в .env поменяйте и раздайте в чате.
API_KEY=caspian-dev-key
# Подпись настоящих пропусков (JWT HS256). Моки подписаны отдельным публичным ключом.
JWT_SECRET=change-me
# «Сейчас» сценария, UTC. Пусто — при каждом reset текущее время, отброшенное до часа,
# и весь сценарий сдвигается к нему (шторм через 36 ч, паром А через 44 ч). Задано — ручная фиксация.
# DEMO_NOW=2026-11-12T11:00:00Z
# Погода: live — Open-Meteo Marine (раз в 30 мин, кэш в data/weather_cache.json, при сбое — кэш);
# synthetic — синтетический прогноз, сеть не трогаем (страховка: шторм на самом деле или нет интернета).
WEATHER_MODE=live

# Предиктор срыва стыковки: catboost — классификатор data/model.cbm (обучен на синтетической истории),
# formula — логистическая формула. Нет модели или catboost не ставится — сервер сам откатится на формулу.
PREDICTOR=catboost

# Telegram-бот диспетчера: токен от @BotFather. Пусто — сервер работает без бота.
BOT_TOKEN=
# ИИ для свободных вопросов в боте (любой OpenAI-совместимый API). Пусто — бот работает на кнопках.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
