# Скопировать в .env (run.ps1 / run.sh делают это сами). .env в репозиторий не коммитить.
# Общий ключ команды для X-API-Key — в .env поменяйте и раздайте в чате.
API_KEY=caspian-dev-key
# Подпись настоящих пропусков (JWT HS256). Моки подписаны отдельным публичным ключом.
JWT_SECRET=change-me
# «Сейчас» сценария, UTC. По умолчанию 12 ноя 14:00 МСК.
# DEMO_NOW=2026-11-12T11:00:00Z

# Telegram-бот диспетчера: токен от @BotFather. Пусто — сервер работает без бота.
BOT_TOKEN=
# ИИ для свободных вопросов в боте (любой OpenAI-совместимый API). Пусто — бот работает на кнопках.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
