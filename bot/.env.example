BOT_TOKEN=123456:ABC...
# Любой OpenAI-совместимый API: OpenRouter, YandexGPT (OpenAI-compatible), локальный vLLM и т.д.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-...
LLM_MODEL=openai/gpt-4o-mini
# Бэкенд команды (сайт/мобилка ходят туда же). Пусто = бот работает без бэкенда
BACKEND_URL=
BACKEND_TOKEN=
# Telegram ID админов через запятую (для /broadcast и /stats)
ADMIN_IDS=
SYSTEM_PROMPT=Ты — дружелюбный ассистент проекта. Отвечай кратко и по делу, на русском.
