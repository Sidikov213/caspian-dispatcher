{
  "name": "chess-coach",
  "version": "0.1.0",
  "description": "Шахматный тренер: игра с ботом с подсказками и разбор партий (Stockfish + chessground)",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "engine": "node scripts/copy-engine.mjs",
    "dev": "npm run engine && vite",
    "build": "npm run engine && tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "local.chesscoach",
    "productName": "Chess Coach",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "chessground": "^9.2.1",
    "chessops": "^0.15.1",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
